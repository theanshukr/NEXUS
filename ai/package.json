{
  "name": "nexusops-ai-platform",
  "version": "1.0.0",
  "description": "NexusOps AI Co-Pilot Platform — Independent AI workspace providing conversational intelligence, agentic tool execution, RAG search, and MCP compatibility on top of the NexusOps backend.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "dev": "node --watch --env-file=.env src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ --ext .js"
  },
  "imports": {
    "#ai/*": "./src/*"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@upstash/redis": "^1.34.3",
    "cors": "^2.8.5",
    "envalid": "^8.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "groq-sdk": "^0.12.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.4",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "uuid": "^11.0.5",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
