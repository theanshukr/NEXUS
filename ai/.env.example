# ──────────────────────────────────────────────────
#  NexusOps AI Platform — Environment Configuration
#  Copy this to .env and fill in your values.
# ──────────────────────────────────────────────────

# ── Server ─────────────────────────────────────────
NODE_ENV=development
AI_PORT=8001
AI_HOST=0.0.0.0

# ── Backend integration ─────────────────────────────
# Must point to the running NexusOps Express backend
BACKEND_API_URL=http://localhost:5000
# Must match the backend's JWT_ACCESS_SECRET exactly
JWT_ACCESS_SECRET=your-jwt-secret-must-match-backend

# ── MongoDB (AI-owned DB — same cluster, separate name) ───
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net
MONGODB_DB_NAME=nexusops_ai

# ── Upstash Redis (conversation memory) ────────────
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── LLM Provider API Keys ───────────────────────────
GEMINI_API_KEY=your-google-gemini-api-key
GROQ_API_KEY=your-groq-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# ── Provider routing (gemini | groq | openrouter) ───
AI_DEFAULT_PROVIDER=gemini
AI_FALLBACK_PROVIDER=openrouter
AI_GEMINI_MODEL=gemini-1.5-pro
AI_GROQ_MODEL=llama-3.3-70b-versatile
AI_OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ── Token cost tracking (USD per 1M tokens) ─────────
GEMINI_INPUT_COST_PER_1M=3.50
GEMINI_OUTPUT_COST_PER_1M=10.50
GROQ_INPUT_COST_PER_1M=0.59
GROQ_OUTPUT_COST_PER_1M=0.79
OPENROUTER_INPUT_COST_PER_1M=3.00
OPENROUTER_OUTPUT_COST_PER_1M=15.00

# ── Conversation memory ──────────────────────────────
AI_CONVERSATION_MAX_TURNS=10
AI_CONTEXT_SUMMARY_TURNS=5
AI_CONVERSATION_TTL_HOURS=24

# ── Rate limiting ────────────────────────────────────
AI_RATE_LIMIT_REQUESTS=20
AI_RATE_LIMIT_WINDOW_MS=900000

# ── RAG pipeline ─────────────────────────────────────
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_VECTOR_DIMENSIONS=768
RAG_TOP_K=5
MONGODB_VECTOR_INDEX=nexusops_vector_index

# ── Feature flags ────────────────────────────────────
AI_ENABLED=true
AI_TOOLS_ENABLED=true
AI_RAG_ENABLED=true
AI_SAFETY_ENABLED=true
