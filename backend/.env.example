# ==============================================================================
# NexusOps — Enterprise Workforce Management Platform
# Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure your cloud & authentication credentials:
#   cp .env.example .env

# Server & Application Environment
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection String (Requires Replica Set for ACID Transactions)
# Example format: mongodb+srv://<username>:<password>@<cluster-domain>.mongodb.net/workforce_db?retryWrites=true&w=majority
MONGODB_URI=

# Upstash Redis REST Serverless Cache Credentials
# Obtain from your Upstash console -> Redis Database -> REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cryptographic JWT Secret Keys (Generate high-entropy strings >= 32 chars)
JWT_ACCESS_SECRET=your_super_secret_access_token_signing_key_2026
JWT_REFRESH_SECRET=your_super_secret_refresh_token_signing_key_2026