# ==========================================
# NEXUS Environment Configuration
# ==========================================

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=nexus-super-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nexus_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nexus_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus_db

# AI / LLM Configuration
# Options: openai, anthropic, gemini, mock
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Alternative Providers
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend (Vite)
VITE_API_URL=http://localhost:8000/api/v1
